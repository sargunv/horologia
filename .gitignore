mobile/local.properties

# Xcode — .xcodeproj is generated by xcodegen from mobile/iosApp/project.yml
mobile/iosApp/*.xcodeproj/
mobile/iosApp/*.xcworkspace/

# typespec
tsp-output/

# playwright
.playwright-cli/
.playwright/
