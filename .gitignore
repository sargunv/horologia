.env.local

# Go
/server/horologia-server
/server/dev-oidc
/clients/cli/horo
*.out

# Web
node_modules/
dist/

# Embedded SPA (populated at build time)
/server/internal/webui/dist/*
!/server/internal/webui/dist/.gitkeep

# postgres dev data (per-branch)
.postgres/

# tilt
.tilt/

# dprint
.dprint/

# gradle
clients/native/.gradle/
clients/native/.kotlin/
clients/native/**/build/
clients/native/local.properties

# Xcode — generated by xcodegen from clients/native/swiftui-app/project.yml
clients/native/swiftui-app/*.xcodeproj/
clients/native/swiftui-app/*.xcworkspace/
clients/native/swiftui-app/iosApp/Info.plist
clients/native/swiftui-app/Developer.xcconfig

# typespec
tsp-output/

# playwright
.playwright-cli/
.playwright/
