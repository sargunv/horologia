amends "package://github.com/jdx/hk/releases/download/v1.38.0/hk@1.38.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v1.38.0/hk@1.38.0#/Builtins.pkl"

local allSteps = new Mapping<String, Step> {
  ["dprint"] = Builtins.dprint
  ["generate-schema"] {
    glob = List("api/**/*.tsp", "web/src/api/schema.d.ts")
    fix = "cd api && pnpm exec tsp compile . && cd ../web && pnpm exec openapi-typescript ../api/tsp-output/schema/openapi.yaml -o src/api/schema.d.ts"
  }
  ["generate-routes"] {
    glob = List("web/src/routes/**/*.tsx", "web/src/routes/**/*.ts", "web/src/routeTree.gen.ts")
    fix = "cd web && pnpm exec tsr generate"
  }
  ["jvl"] {
    glob = List("**/*.json", "**/*.jsonc")
    check = "jvl check {{files}}"
  }
  ["gomod-tidy"] = (Builtins.gomod_tidy) {
    glob = List("**/go.mod")
    workspace_indicator = "go.mod"
    check_diff = "cd {{workspace}} && go mod tidy -diff"
    fix = "cd {{workspace}} && go mod tidy"
  }
  ["golangci-lint"] {
    glob = List("**/*.go")
    workspace_indicator = "go.mod"
    check = "cd {{workspace}} && golangci-lint run ./..."
    fix = "cd {{workspace}} && golangci-lint run --fix ./..."
  }
  ["vp-check"] {
    glob = List("**/*.ts", "**/*.tsx", "**/*.js", "**/*.jsx")
    check = "cd web && pnpm exec vp check --no-fmt"
    fix = "cd web && pnpm exec vp check --no-fmt --fix"
  }
  ["tsp-format"] {
    glob = List("api/**/*.tsp")
    check = "cd api && pnpm exec tsp format . --check"
    fix = "cd api && pnpm exec tsp format ."
  }
}

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps {
      ...allSteps
    }
  }
  ["check"] {
    steps {
      ...allSteps
    }
  }
  ["fix"] {
    fix = true
    steps {
      ...allSteps
    }
  }
}
